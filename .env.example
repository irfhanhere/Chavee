# Copy to .env and fill in. CLIENT-SIDE (VITE_) VALUES ONLY.
# Vite inlines these into the public browser bundle — never put a secret here.
#
# Server-side secrets are not kept in any repo file. Set them with:
#   npx supabase secrets set NAME=value --project-ref <ref>
# Required Edge Function secrets (see supabase/functions/*/index.ts):
#   CASHFREE_APP_ID, CASHFREE_SECRET_KEY, CASHFREE_ENV
#   CF_SERVICE_ROLE_KEY, TURNSTILE_SECRET_KEY
#   BREVO_API_KEY, RESEND_API_KEY
#   TICKET_WEBHOOK_SECRET, SUPPORT_NOTIFICATION_EMAIL

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_TURNSTILE_SITE_KEY=0xAAAAAAAAAAAAAAAAAAAAAA
